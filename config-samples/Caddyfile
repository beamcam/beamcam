# Caddy: static app + signaling proxy. Replace cam.example.org with your
# APP_DOMAIN and the root with the absolute path of dist/.
# Caddy fetches and renews the TLS certificate by itself.

cam.example.org {
    root * /srv/cam/dist
    file_server

    # Signaling server (HTTP + WebSocket)
    @signaling path /peerjs /peerjs/*
    reverse_proxy @signaling 127.0.0.1:9000 {
        header_up X-Forwarded-For {remote_host}
        transport http {
            read_timeout 7d
            write_timeout 7d
        }
    }

    header {
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), screen-wake-lock=(self)"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }
}
